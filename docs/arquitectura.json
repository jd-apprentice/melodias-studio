  "cards": [
    {
      "dot": "cyan",
      "title": "Contratos HTTP",
      "items": [
        "llama-server /v1/chat/completions escribe el prompt de imagen",
        "sd-server /v1/images/generations devuelve b64_json 1280x720",
        "audiocpp /v1/tasks/run genera con reference_audio",
        "Cada etapa espera su health check hasta 180 s"
      ]
    },
    {
      "dot": "amber",
      "title": "Orden de VRAM",
      "items": [
        "Una sola P40 de 24 GB atiende los tres servicios",
        "llama-server (3.4 GB) y sd-server (11.4 GB) conviven",
        "sd-server se detiene antes de cargar ACE-Step (10 GB)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Loop y salida",
      "items": [
        "audio.mp3 320 kbps, -15 LUFS, crossfade fijo de 3 s",
        "El PNG se valida leyendo su cabecera",
        "meta.json guarda seed, prompts y parámetros",
        "work/ conserva fuente, referencia y toma"
      ]
    },
    {
      "dot": "violet",
      "title": "Fuente y referencia",
      "items": [
        "yt-dlp extrae WAV 48 kHz estéreo",
        "La referencia es el minuto de mayor energía RMS",
        "scp la deja en /models/ref antes de la etapa de audio"
      ]
    }
  ]
