  "cards": [
    {
      "dot": "cyan",
      "title": "HTTP contracts",
      "items": [
        "llama-server /v1/chat/completions writes the image prompt",
        "sd-server /v1/images/generations returns b64_json at 1280x720",
        "audiocpp /v1/tasks/run generates with reference_audio",
        "Each stage waits for its health check, up to 180 s"
      ]
    },
    {
      "dot": "amber",
      "title": "VRAM order",
      "items": [
        "One 24 GB P40 serves all three services",
        "llama-server (3.4 GB) and sd-server (11.4 GB) coexist",
        "The LLM and sd-server stop before ACE-Step loads",
        "mem_saver keeps ACE-Step near 14.7 GB between requests"
      ]
    },
    {
      "dot": "emerald",
      "title": "Pools, review and output",
      "items": [
        "candidates/ keeps N images and N audio drafts",
        "3 images at 20 steps and 3 drafts at 60 s by default",
        "The judge (Gemini 4 Argon via OpenCode Go) preselects the pair; the TUI can override it",
        "video.mp4 with ffmpeg or Remotion (overlays, waveform, branding)",
        "melodias image/render/video rebuild pieces without the GPU",
        "meta.json stores candidates, seeds, judge and selection"
      ]
    },
    {
      "dot": "violet",
      "title": "Reference source",
      "items": [
        "yt-dlp pulls the reference as a 48 kHz stereo WAV",
        "The reference is the minute with the highest RMS energy",
        "scp leaves it in /models/ref before the audio stage",
        "The reference conditions timbre, not the melody"
      ]
    }
  ]
